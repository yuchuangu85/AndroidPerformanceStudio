+package com.android.tools.ui.inspector.payload;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import com.android.tools.ui.inspector.common.FramingProtocol;
+import com.android.tools.ui.inspector.protocol.UiInspectorProtocol;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.concurrent.CountDownLatch;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+@RunWith(RobolectricTestRunner.class)
+public class SessionShutdownLifecycleTest {
+  private static final byte[] TOKEN = "test-session-token".getBytes(StandardCharsets.UTF_8);
+
+  @Test
+  public void authenticatedEofReleasesTheAgent() throws Exception {
+    assertThat(runSession(TOKEN, false, new ByteArrayOutputStream()).getCount()).isEqualTo(0);
+  }
+
+  @Test
+  public void rejectedAuthenticationDoesNotReleaseTheAgent() throws Exception {
+    assertThat(runSession("wrong-token".getBytes(StandardCharsets.UTF_8), false,
+        new ByteArrayOutputStream()).getCount()).isEqualTo(1);
+  }
+
+  @Test
+  public void failedShutdownAcknowledgementStillReleasesTheAgent() throws Exception {
+    OutputStream brokenPeer = new OutputStream() {
+      @Override public void write(int value) throws IOException {
+        throw new IOException("host already disconnected");
+      }
+    };
+    assertThat(runSession(TOKEN, true, brokenPeer).getCount()).isEqualTo(0);
+  }
+
+  private CountDownLatch runSession(byte[] token, boolean shutdown, OutputStream output)
+      throws Exception {
+    ByteArrayOutputStream input = new ByteArrayOutputStream();
+    FramingProtocol.writeMessage(input, token);
+    if (shutdown) {
+      FramingProtocol.writeMessage(input, UiInspectorProtocol.Command.newBuilder()
+          .setCommandId(1).setShutdown(UiInspectorProtocol.ShutdownCommand.getDefaultInstance())
+          .build().toByteArray());
+    }
+    CountDownLatch latch = new CountDownLatch(1);
+    new SessionHandler(new ByteArrayInputStream(input.toByteArray()), output, error -> {},
+        latch, new HashMap<>(), TOKEN).processCommands();
+    return latch;
+  }
+}
