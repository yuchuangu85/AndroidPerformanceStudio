{
  "name": "android-performance-studio-electron-viewer",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "//": "pnpm 10+ skips dependency build scripts unless they are listed here. Electron postinstall is what unpacks node_modules/electron/dist, and without it neither the dev server nor electron-vite can start the app.",
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "perf:hierarchy": "APS_PERF=1 vitest run --root packages/layout-inspector src/fixtures/perf.test.ts",
    "perf:ui": "node e2e/ui-perf.mjs",
    "package:smoke": "pnpm --filter @aps/desktop package:dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
