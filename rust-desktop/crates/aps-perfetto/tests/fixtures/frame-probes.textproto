packet { process_tree { processes { pid:30 cmdline:"com.example" } threads {tid:30 tgid:30 name:"main"} threads {tid:31 tgid:30 name:"RenderThread"} processes {pid:40 cmdline:"other.app"} threads {tid:40 tgid:40 name:"main"} } }
packet { timestamp:100 [com.android.internal.FrameworksNativeTracePacket.frame_timeline_event] { expected_surface_frame_start {cookie:1 token:11 display_frame_token:7 pid:30 layer_name:"A"} } }
